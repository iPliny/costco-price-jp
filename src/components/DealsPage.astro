---
import Base from '../layouts/Base.astro';
import FavButton from './FavButton.astro';
import { loadProducts, weeklyDeals, yen, CRAWLED, storeOrder } from '../lib/data.js';
import { t, localePath, productName, storeName, statusName, noteText, monthDay } from '../lib/i18n.js';
import { loadCoupons, activeCoupons, couponList, couponToday } from '../lib/coupons.js';

const { lang } = Astro.props;
const s = t(lang);
const products = loadProducts();
const deals = weeklyDeals(products);
const asOf = couponToday();
const coupons = activeCoupons(loadCoupons(), products, asOf);
const couponPeriod = coupons.length ? s.couponsPeriod(monthDay(asOf), monthDay(coupons.map((r) => r.week_to).sort().at(-1))) : '';
const date = monthDay(deals.updated);
const title = coupons.length ? s.dealsTitleCoupons(date) : s.dealsTitle(date);
const description = s.dealsDescription(deals.storeSales.length, deals.onlineSales.length, deals.priceDrops.length, date) + (coupons.length ? s.couponsDescription(coupons.length, couponPeriod) : '');
const pageUrl = new URL(localePath(lang, 'deals/'), Astro.site).href;
const homeUrl = new URL(localePath(lang), Astro.site).href;
const aboutUrl = new URL(localePath(lang, 'about/'), Astro.site).href;
const inLanguage = lang === 'ja' ? 'ja' : 'zh-Hant';
const listedStores = [...new Set([...deals.storeSales, ...deals.endedSales, ...deals.priceDrops].flatMap((card) => card.records.map(({ observation: o }) => o.store)))]
  .sort(storeOrder).map((store) => storeName(lang, store)).join(s.storeJoin);
const sections = [
  { id: 'store-sales', title: s.dealsStore, jump: s.dealsJumpStore, note: s.dealsStoreNote, cards: deals.storeSales },
  { id: 'online-sales', title: s.dealsOnline, jump: s.dealsJumpOnline, note: s.dealsOnlineNote, cards: deals.onlineSales },
  { id: 'price-drops', title: s.dealsDrops, jump: s.dealsJumpDrops, note: s.dealsDropsNote, cards: deals.priceDrops },
];
const observed = (o) => o.source_type === CRAWLED ? s.crawledOn(o.period_from, o.period_to) : s.period(o.period_from, o.period_to);
const price = (n, o) => yen(n) + (o.price_unit === '100g' ? s.per100g : '');
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${pageUrl}#webpage`,
  url: pageUrl, name: s.dealsHeading(date), description, inLanguage,
  author: { '@type': 'Person', name: 'ハクイ', url: aboutUrl,
    worksFor: { '@type': 'Organization', name: s.brand, url: homeUrl } },
  breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  mainEntity: [...sections.map(({ id }) => ({ '@id': `${pageUrl}#${id}` })), ...(coupons.length ? [{ '@id': `${pageUrl}#coupons` }] : [])],
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: s.monthlyBreadcrumbHome, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: s.dealsPageLabel, item: pageUrl },
  ],
}, ...sections.map(({ id, title, cards }) => ({
  '@context': 'https://schema.org', '@type': 'ItemList', '@id': `${pageUrl}#${id}`,
  name: title, url: `${pageUrl}#${id}`, numberOfItems: cards.length,
  itemListElement: cards.slice(0, 20).map(({ product: p }, i) => ({
    '@type': 'ListItem', position: i + 1, name: productName(lang, p),
    url: new URL(localePath(lang, `item/${p.id}/`), Astro.site).href,
  })),
})), ...(coupons.length ? [couponList(coupons, lang, pageUrl, Astro.site)] : [])];

---
<Base lang={lang} path="deals/" title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={s.brand} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'zh_TW'} />
    <meta property="og:locale:alternate" content={lang === 'ja' ? 'zh_TW' : 'ja_JP'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <nav class="breadcrumbs small" aria-label={s.dealsBreadcrumbLabel}>
    <a href={localePath(lang)}>{s.monthlyBreadcrumbHome}</a> › <span aria-current="page">{s.dealsPageLabel}</span>
  </nav>
  <h1>{coupons.length ? s.dealsHeadingCoupons(date) : s.dealsHeading(date)}</h1>
  <p class="muted small"><a href={localePath(lang, 'about/')}>{s.editor}</a> ・{s.dealsMeta(deals.updated ?? s.dealsNoDate, deals.from ?? s.dealsNoDate, deals.anchor ?? s.dealsNoDate)}</p>
  <p class="lead">{s.dealsLead}</p>
  {listedStores && <p class="muted small">{s.dealsStoreCoverage(listedStores)}</p>}
  <p class="muted small">{s.dealsMethod} <a href={localePath(lang, 'about/')}>{s.methodLink}</a></p>
  <nav class="section-links small" aria-label={s.dealsJumpLabel}>
    {sections.map(({ id, jump, cards }) => <a href={`#${id}`}>{jump}（{s.dealsCount(cards.length)}）</a>)}
    {coupons.length > 0 && <a href="#coupons">{s.couponsJump}（<span data-coupon-count>{s.dealsCount(coupons.length)}</span>）</a>}
  </nav>
  {sections.map(({ id, title, note, cards }) => (
    <section id={id}>
      <h2>{title}（{s.dealsCount(cards.length)}）</h2>
      <p class="muted small">{note}</p>
      {[{ cards, ended: false }, ...(id === 'store-sales' ? [{ cards: deals.endedSales, ended: true }] : [])].map((group) => {
        const Tag = group.ended ? 'details' : 'div';
        return <Tag class={group.ended ? 'ended-sales' : undefined}>
          {group.ended && <summary>{s.dealsEnded(group.cards.length)}</summary>}
          {group.cards.length ? <ul class="deal-list">{group.cards.map(({ product: p, records }) => (
            <li class="deal-card" data-item={p.item_no}>
                <div class="card-heading">
                  <div><h3><a href={localePath(lang, `item/${p.id}/`)}>{productName(lang, p)}</a></h3>
                  <p class="muted small">{s.itemNoLabel(p.item_no)}</p></div>
                  <FavButton id={p.id} lang={lang} compact />
                </div>
                <ul class="store-records">
                  {records.map(({ observation: o, previous, reduction }) => (
                    <li data-record={o.record_id}>
                      <div class="store-top"><strong>{storeName(lang, o.store)}</strong>
                        <span class={o.review_status === '已查核' ? 'badge ok' : 'badge pending'}>{statusName(lang, o.review_status)}</span>
                      </div>
                      {previous && <p class="small">{s.dealsPrevious(price(previous.price, previous), observed(previous))} →</p>}
                      <p class="price">{price(o.price, o)}</p>
                      <dl>
                        {!previous && <><dt>{s.wasPrice}</dt><dd>{price(o.list_price, o)}</dd></>}
                        <dt>{s.off}</dt><dd>{price(reduction, o)}</dd>
                        {o.promo_end && <><dt>{s.promoEnd}</dt><dd>{o.promo_end}</dd></>}
                        <dt>{s.observed}</dt><dd>{observed(o)}</dd>
                        {noteText(lang, o) && <><dt>{s.note}</dt><dd>{noteText(lang, o)}</dd></>}
                      </dl>
                    </li>
                  ))}
                </ul>
              </li>
          ))}</ul> : <p>{s.dealsEmpty}</p>}
        </Tag>;
      })}
    </section>
  ))}
  {coupons.length > 0 && <section id="coupons">
    <h2>{s.couponsTitle}（<span data-coupon-count>{s.dealsCount(coupons.length)}</span>{couponPeriod}）</h2>
    <p class="muted small">{s.couponsNote}</p>
    <input class="coupon-filter" type="search" data-coupon-filter placeholder={s.couponsFilter} aria-label={s.couponsFilter} hidden />
    <ul class="deal-list coupon-list">{coupons.map((row) => <li class="deal-card coupon-card" data-coupon={row.item_no} data-until={row.week_to} data-search={`${row.name_ja} ${row.item_no}`.toLowerCase()}>
      <div class="store-top"><h3>{row.product ? <a href={localePath(lang, `item/${row.product.id}/`)}>{row.name_ja}</a> : row.name_ja}</h3>
        <span class="badge">{s.couponsBadge}</span></div>
      <p class="coupon-line">
        {row.discount_yen == null ? <span class="off">{s.couponsSpecial}</span> : <span class="off">{s.off} {price(row.discount_yen, row)}</span>}
        {row.price_after != null && <strong>{price(row.price_after, row)}</strong>}
        <span class="muted">{row.week_from || s.couponsStartUnknown} 〜 {row.week_to}</span>
      </p>
      <p class="muted small">{s.itemNoLabel(row.item_no)} ・{row.scope === '倉庫店' ? s.couponsWarehouse : s.couponsOnline} ・{s.couponsSource} {row.source === '電子報' ? s.couponsNewsletter : s.couponsOfficial}</p>
    </li>)}</ul>
    <p class="muted small" data-coupon-empty hidden>{s.couponsNoMatch}</p>
    <button type="button" class="coupon-more" data-coupon-more hidden></button>
  </section>}
  {coupons.length > 0 && <script is:inline define:vars={{ countTemplate: s.dealsCount(0), moreTemplate: s.couponsShowAll(0) }}>
    // 靜態頁不一定每天重建：在瀏覽器把已過期的折價券藏起來（日本時間）。
    // 清單很長：先顯示前 PAGE 筆，可展開或用品名／番號篩選。
    (() => {
      const PAGE = 12;
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(new Date());
      const cards = [...document.querySelectorAll('#coupons [data-until]')];
      const live = cards.filter((li) => li.dataset.until >= today);
      if (live.length !== cards.length) document.querySelectorAll('[data-coupon-count]').forEach((el) => { el.textContent = countTemplate.replace('0', String(live.length)); });
      if (!live.length) {
        cards.forEach((li) => { li.hidden = true; });
        document.getElementById('coupons').hidden = true;
        document.querySelector('.section-links a[href="#coupons"]')?.setAttribute('hidden', '');
        return;
      }
      const input = document.querySelector('[data-coupon-filter]');
      const more = document.querySelector('[data-coupon-more]');
      const empty = document.querySelector('[data-coupon-empty]');
      let expanded = false;
      const render = () => {
        const q = input.value.trim().toLowerCase();
        const matches = live.filter((li) => !q || li.dataset.search.includes(q));
        const shown = q || expanded ? matches : matches.slice(0, PAGE);
        cards.forEach((li) => { li.hidden = !shown.includes(li); });
        empty.hidden = matches.length > 0;
        const rest = matches.length - shown.length;
        more.hidden = rest <= 0;
        more.textContent = moreTemplate.replace('0', String(rest));
      };
      input.hidden = live.length <= PAGE;
      input.addEventListener('input', render);
      more.addEventListener('click', () => { expanded = true; render(); });
      render();
    })();
  </script>}
  <nav class="related small">
    <a href={localePath(lang, 'ranking/')}>{s.tabWeekly}</a>
    <a href={localePath(lang, 'ranking/monthly/')}>{s.tabMonthly}</a>
    <a href={localePath(lang, 'recent/')}>{s.recentLink}</a>
    {lang === 'zh' && <a href={localePath(lang, 'blog/')}>{s.navBlog}</a>}
  </nav>
</Base>
<style>
  h1 { font-size: 1.5rem; line-height: 1.45; margin: 0 0 8px; }
  h2 { font-size: 1.2rem; margin: 24px 0 10px; }
  h3 { font-size: 1.05rem; margin: 0 0 4px; }
  .small { font-size: .85rem; }
  .breadcrumbs { margin: 0 0 16px; color: var(--muted); }
  .lead { margin: 12px 0; }
  .section-links { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
  .section-links a { text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 6px 10px; background: var(--card); }
  section { scroll-margin-top: 16px; }
  .deal-list, .store-records { list-style: none; padding: 0; display: grid; gap: 10px; }
  .deal-card { min-width: 0; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); overflow-wrap: anywhere; }
  .card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .card-heading > div { min-width: 0; }
  .card-heading p { margin: 0; }
  .store-records > li { border-top: 1px solid var(--line); padding-top: 10px; }
  .store-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
  .price { font-weight: 700; font-size: 1.3rem; margin: 4px 0; }
  dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px 12px; font-size: .85rem; margin: 0; }
  dt { color: var(--muted); } dd { margin: 0; }
  summary { cursor: pointer; color: var(--accent); }
  .coupon-filter { width: 100%; box-sizing: border-box; font: inherit; padding: 8px 12px; margin: 4px 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: inherit; }
  .coupon-card h3 { font-size: 1rem; }
  .coupon-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 6px 0 2px; }
  .coupon-line strong { font-size: 1.15rem; }
  .coupon-line .off { color: var(--accent); font-weight: 700; }
  .coupon-card .small { margin: 0; }
  .coupon-more[hidden] { display: none; }
  .coupon-more { display: block; width: 100%; margin: 12px 0 0; padding: 10px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--accent); cursor: pointer; }
  .ended-sales { margin-top: 12px; }
  .related { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 28px; }
</style>
