---
import Base from '../layouts/Base.astro';
import { loadProducts, loadCategories, sortProducts, inCategory } from '../lib/data.js';
import ProductList from './ProductList.astro';
import { t, storeName, localePath } from '../lib/i18n.js';

const { lang } = Astro.props;
const s = t(lang);
const products = sortProducts(loadProducts());
const categories = loadCategories();
const tops = categories.filter((c) => !c.parent);
const categoryCount = (id) => products.filter((p) => inCategory(p, id)).length;
// 店別照固定順序，線上商店放最後（大家都查得到）。
const STORE_ORDER = ['熊本御船倉庫店', '座間倉庫店', '新三郷倉庫店', '川崎倉庫店', '浜松倉庫店', '線上商店'];
const storeOrder = (st) => (STORE_ORDER.includes(st) ? STORE_ORDER.indexOf(st) : STORE_ORDER.length - 1);
const stores = [...new Set(products.flatMap((p) => p.stores))].sort((a, b) => storeOrder(a) - storeOrder(b) || a.localeCompare(b, 'ja'));
// 每個店別按鈕後面標出有紀錄的商品數。
const storeCount = (st) => products.filter((p) => p.stores.includes(st)).length;
---
<Base lang={lang} path="" title={s.homeTitle}>
  <h1>{s.heading}</h1>
  <p class="lead">{s.leadClaim}<a class="claim-mark" href="#claim-note" aria-label="注記">※</a>{s.lead}</p>
  <p class="muted">{s.summary(products.length, stores.length, products.reduce((n, p) => n + p.observations.length, 0))}</p>

  <div class="recent-entry">
    <a href={localePath(lang, 'recent/')}>{s.recentLink} →</a>
    <span class="muted">{s.recentHomeNote}</span>
  </div>

  <input id="q" type="search" placeholder={s.searchPlaceholder} aria-label={s.searchPlaceholder} autocomplete="off" />
  <div class="chips" id="stores">
    <button class="chip active" data-store="">{s.allStores}({products.length})</button>
    {stores.map((st) => <button class="chip" data-store={st}>{storeName(lang, st)}({storeCount(st)})</button>)}
  </div>

  <div class="chips" id="categories">
    <button class="chip active" data-cat="" aria-pressed="true">{s.allCategories}({products.length})</button>
    {tops.map((c) => <button class="chip" data-cat={c.id} aria-pressed="false">{c[lang]}({categoryCount(c.id)})</button>)}
  </div>
  {tops.filter((c) => !c.special).map((top) => (
    <div class="chips subcategories" data-parent={top.id} hidden>
      <button class="chip" data-cat={top.id} aria-pressed="false">{s.allInCategory}({categoryCount(top.id)})</button>
      {categories.filter((c) => c.parent === top.id && categoryCount(c.id)).map((c) => (
        <button class="chip" data-cat={c.id} aria-pressed="false">{c[lang]}({categoryCount(c.id)})</button>
      ))}
    </div>
  ))}

  <ProductList products={products} lang={lang} />
  <p id="empty" class="muted" hidden>{s.empty}</p>
  <p id="claim-note" class="muted small lead-note">{s.leadNote}</p>

  <style>
    h1 { font-size: 1.5rem; margin: 0 0 4px; }
    .lead { font-weight: 600; margin: 0 0 4px; }
    .lead-note { margin: 24px 0 0; font-size: .75rem; }
    .claim-mark { font-size: .75em; vertical-align: super; text-decoration: none; margin: 0 1px; }
    .recent-entry { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 12px 0; font-size: .85rem; }
    .recent-entry a { display: inline-block; padding: 8px 14px; border: 1px solid var(--accent); border-radius: 999px;
      background: var(--accent-bg); text-decoration: none; font-weight: 600; }
    .recent-entry a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    input[type=search] { width: 100%; font-size: 1rem; padding: 12px 14px; border-radius: 10px;
      border: 1px solid var(--line); background: var(--card); color: var(--text); margin: 12px 0; }
    .chips { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; margin-bottom: 12px; }
    .chip { flex: none; border: 1px solid var(--line); background: var(--card); color: var(--text);
      border-radius: 999px; padding: 6px 12px; font-size: .85rem; cursor: pointer; }
    .chips[hidden] { display: none; }
    .chips { max-width: 100%; }
    .chip.active { background: var(--accent-bg); border-color: var(--accent); color: var(--accent); }
  </style>

  <script>
    const q = document.getElementById('q');
    const items = [...document.querySelectorAll('#list li')];
    const stores = [...document.querySelectorAll('#stores .chip')];
    const categories = [...document.querySelectorAll('[data-cat]')];
    const groups = [...document.querySelectorAll('[data-parent]')];
    const empty = document.getElementById('empty');
    let store = '';
    let category = '';
    function apply(updateUrl = true) {
      const term = q.value.trim().toLowerCase();
      const child = categories.find((c) => c.dataset.cat === category && c.closest('[data-parent]'));
      const top = child?.closest('[data-parent]').dataset.parent ?? category;
      groups.forEach((g) => { g.hidden = g.dataset.parent !== top; });
      categories.forEach((c) => {
        const active = c.dataset.cat === (c.closest('#categories') ? top : category);
        c.classList.toggle('active', active);
        c.setAttribute('aria-pressed', String(active));
      });
      let shown = 0;
      for (const li of items) {
        const ok = (!term || li.dataset.search.includes(term)) &&
          (!store || li.dataset.stores.split('|').includes(store)) &&
          (!category || (category === 'popular' ? li.dataset.popular === 'true' :
            li.dataset.category === category || li.dataset.top === category));
        li.hidden = !ok;
        if (ok) shown++;
      }
      empty.hidden = shown > 0;
      if (updateUrl) {
        const url = new URL(location.href);
        if (category) url.searchParams.set('cat', category); else url.searchParams.delete('cat');
        if (q.value) url.searchParams.set('q', q.value); else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
    }
    q.addEventListener('input', () => apply());
    const initial = new URLSearchParams(location.search);
    q.value = initial.get('q') ?? '';
    if (categories.some((c) => c.dataset.cat === initial.get('cat'))) category = initial.get('cat');
    apply(false);
    for (const c of stores) c.addEventListener('click', () => {
      stores.forEach((x) => {
        x.classList.toggle('active', x === c);
        x.setAttribute('aria-pressed', String(x === c));
      });
      store = c.dataset.store;
      apply();
    });
    for (const c of categories) c.addEventListener('click', () => {
      category = c.dataset.cat;
      apply();
    });
  </script>
</Base>
