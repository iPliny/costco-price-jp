---
import Base from '../layouts/Base.astro';
import { loadHeat, loadProducts, loadReports, yen, COMMUNITY } from '../lib/data.js';
import { t, storeName, sourceName, noteText } from '../lib/i18n.js';

const { lang } = Astro.props;
const s = t(lang);
// 最新一週在最上面，舊的週次往下保留。
const weeks = loadHeat().reverse();
// 每個排名商品直接列出價格：站上對應商品的價牌／官網紀錄，加上當週群組回報（依紀錄編號去重）。
const products = loadProducts();
function prices(h) {
  const q = h.query.toLowerCase();
  const matched = products
    .filter((p) => `${p.name} ${p.item_no} ${p.spec}`.toLowerCase().includes(q))
    .flatMap((p) => p.observations.filter((o) => o.source_type !== COMMUNITY));
  const rows = [...matched, ...loadReports(h.reports ?? [])];
  const seen = new Set();
  return rows
    .filter((o) => !seen.has(o.record_id) && seen.add(o.record_id))
    .sort((a, b) => a.store.localeCompare(b.store, 'ja') || a.name.localeCompare(b.name, 'ja'));
}
const week = weeks[0];
const name = (h) => (lang === 'ja' ? h.name_ja : h.name_zh);
const summary = (h) => (lang === 'ja' ? h.summary_ja : h.summary_zh);
---
<Base
  lang={lang}
  path="ranking/"
  title={week ? s.heatPageTitle(week.from, week.to) : s.heatTitle}
  description={week ? s.heatDescription(week.items.map(name).join(s.storeJoin)) : s.heatTitle}
>
  <h1>{s.heatTitle}</h1>
  <p class="muted small">{s.heatNote}</p>
  {weeks.map((w, wi) => (
    <section class="week">
      <h2 class="week-title">{s.heatPeriod(w.from, w.to)}</h2>
      <ol class="rank-list">
        {w.items.map((h, i) => (
          <li>
            <details open={wi === 0 && i === 0}>
              <summary>
                <span class="rank">{h.rank}</span>
                <span class="rank-name">{name(h)}</span>
                <span class="muted small">{s.heatPeople(h.people)}</span>
              </summary>
              <div class="body">
                <h3>{s.heatSummary}</h3>
                <ul>{summary(h).map((line) => <li>{line}</li>)}</ul>
                <h3>{s.heatPrices}</h3>
                {prices(h).length > 0 ? (
                  <>
                    <p class="muted small">{s.heatPricesNote}</p>
                    <ul class="reports">
                      {prices(h).map((o) => (
                        <li>
                          <span class="r-store">{storeName(lang, o.store)}</span>
                          <span class="r-price">{yen(o.price)}{o.price_unit === '100g' && s.per100g}</span>
                          <span class="muted small">{o.name}{o.spec && !o.name.includes(o.spec) && `・${o.spec}`}</span>
                          <span class="muted small">{sourceName(lang, o.source_type)}・{o.source_type === COMMUNITY ? s.reportedOn(o.period_from, o.period_to) : s.period(o.period_from, o.period_to)}</span>
                          {noteText(lang, o) && <span class="muted small">{noteText(lang, o)}</span>}
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <p class="muted small">{s.heatNoPrices}</p>
                )}
                <p class="muted small">{s.heatStores}：{h.stores.map((st) => storeName(lang, st)).join(s.storeJoin)}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <style>
    h1 { font-size: 1.5rem; margin: 0 0 4px; }
    .small { font-size: .85rem; }
    .rank-list { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 8px; }
    details { background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
    summary { display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '＋'; color: var(--muted); margin-left: 4px; }
    details[open] summary::after { content: '－'; }
    .rank { flex: none; width: 1.8em; height: 1.8em; border-radius: 999px; background: var(--accent-bg); color: var(--accent);
      font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
    .rank-name { flex: 1; font-weight: 600; font-size: 1.05rem; }
    .body { padding: 0 14px 12px; border-top: 1px solid var(--line); }
    .week { margin-top: 20px; }
    .week-title { font-size: 1rem; margin: 0; color: var(--muted); font-weight: 600; }
    .body h3 { font-size: .95rem; margin: 12px 0 4px; }
    .body ul { margin: 0 0 8px; padding-left: 1.2em; display: grid; gap: 4px; }
    .body p { margin: 4px 0; }
    .body ul.reports { list-style: none; padding: 0; gap: 6px; }
    .reports li { display: grid; grid-template-columns: 1fr auto; gap: 0 12px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; }
    .reports li > .muted { grid-column: 1 / -1; }
    .r-store { font-weight: 600; }
    .r-price { font-weight: 700; font-variant-numeric: tabular-nums; }
  </style>
</Base>
