---
import Base from '../layouts/Base.astro';
import FavButton from './FavButton.astro';
import { yen, COMMUNITY, CRAWLED, storeOrder, onlineDiff, discussionsFor, loadCategories } from '../lib/data.js';
import { t, storeName, sourceName, statusName, noteText, localePath, productName } from '../lib/i18n.js';

const { p, lang } = Astro.props;
const s = t(lang);
const base = import.meta.env.BASE_URL;
// 價格錯誤回報：開 POYU 的 Google 表單，預填商品番号與店別（店別是下拉選單，值必須完全一致）。
const REPORT_FORM = 'https://docs.google.com/forms/d/e/1FAIpQLSfUbfKas65NDogV8cVmT2TewMTorUvHOdCtEz2pL_fY3UK7SA/viewform';
const FORM_STORES = ['熊本御船', '座間', '新三郷', '川崎', '浜松', '入間'];
const formStore = (st) => (st === '線上商店' ? 'オンライン' : FORM_STORES.find((x) => st.startsWith(x)) ?? 'その他');
const reportUrl = (o) => `${REPORT_FORM}?${new URLSearchParams({ usp: 'pp_url', 'entry.1082419553': o.item_no, 'entry.1812944459': formStore(o.store) })}`;
const name = productName(lang, p);
const categories = loadCategories();
const category = categories.find((c) => c.id === p.category);
const top = categories.find((c) => c.id === p.categoryTop);
const talks = discussionsFor(p.item_no);
const obs = [...p.current].sort((a, b) => storeOrder(a.store, b.store) || (b.period_to || '').localeCompare(a.period_to || ''));
---
<Base lang={lang} path={`item/${p.id}/`} title={s.itemTitle(name)} description={s.itemDescription(name, p.item_no, p.latest && { ...p.latest, store: storeName(lang, p.latest.store) }, p.stores.length)}>
  <p><a href={localePath(lang)}>{s.back}</a></p>
  {(category || p.popular) && <nav class="category-breadcrumbs" aria-label={s.categoryBreadcrumb}>
    {top && <><a href={localePath(lang, `category/${top.id}/`)}>{top[lang]}</a> › </>}
    {category && <a href={localePath(lang, `category/${category.id}/`)}>{category[lang]}</a>}
    {p.popular && <a class="badge ok" href={localePath(lang, 'category/popular/')}>{s.popularBadge}</a>}
  </nav>}
  <div class="title-row">
    <h1>{name}</h1>
    <FavButton id={p.id} lang={lang} />
  </div>
  {p.nameEn && <p class="name-en" lang="en">{p.nameEn}</p>}
  <p class="muted">{s.itemNoLabel(p.item_no)}</p>
  {p.onOfficialSite && (
    <p class="online-link head-link"><a href={`https://www.costco.co.jp/p/${p.item_no}`} rel="noopener" target="_blank">{s.openOnline} ↗</a></p>
  )}

  <h2>{s.history}</h2>
  <p class="muted small">{s.historyNote}</p>
  {obs.some((o) => o.source_type === COMMUNITY) && <p class="muted small">{s.communityNote}</p>}
  <ul class="obs">
    {obs.map((o) => (
      <li>
        <div class="top">
          <span class="store">{storeName(lang, o.store)}</span>
          <span class={o.review_status === '已查核' ? 'badge ok' : 'badge pending'}>{statusName(lang, o.review_status)}</span>
        </div>
        <div class="price">
          {yen(o.price)}{o.price_unit === '100g' && <span class="unit">{s.per100g}</span>}
          {o.list_price && <span class="was muted">{s.wasPrice} {yen(o.list_price)}</span>}
          {o.discount && <span class="off">{s.off} {yen(o.discount)}</span>}
          {onlineDiff(o, p.observations) != null && (
            <span class={onlineDiff(o, p.observations) < 0 ? 'vs cheaper' : onlineDiff(o, p.observations) > 0 ? 'vs pricier' : 'vs'}>{s.vsOnline(onlineDiff(o, p.observations))}</span>
          )}
        </div>
        <dl>
          {o.spec && <><dt>{s.spec}</dt><dd>{o.spec}</dd></>}
          <dt>{s.source}</dt><dd>{sourceName(lang, o.source_type)}</dd>
          <dt>{s.observed}</dt><dd>{o.source_type === CRAWLED ? s.crawledOn(o.period_from, o.period_to) : s.period(o.period_from, o.period_to)}</dd>
          {o.promo_end && <><dt>{s.promoEnd}</dt><dd>{o.promo_end}</dd></>}
          {noteText(lang, o) && <><dt>{s.note}</dt><dd>{noteText(lang, o)}</dd></>}
        </dl>
        {o.source_type === CRAWLED && o.item_no && (
          <p class="online-link"><a href={`https://www.costco.co.jp/p/${o.item_no}`} rel="noopener" target="_blank">{s.openOnline} ↗</a></p>
        )}
        <p class="report"><a href={reportUrl(o)} rel="noopener" target="_blank">{s.reportError}</a></p>
        {o.evidence_image && (
          <details class="evidence">
            <summary>{s.showScreenshot}</summary>
            <img src={`${base}${o.evidence_image}`} alt={s.screenshotAlt(o.name || name)} loading="lazy" width="800" />
          </details>
        )}
      </li>
    ))}
  </ul>

  {talks.length > 0 && (
    <section class="talks">
      <h2>{s.discussions}</h2>
      <p class="muted small">{s.discussionsNote}</p>
      {talks.map((d) => (
        <div class="talk-week">
          <h3>{s.heatPeriod(d.from, d.to)}</h3>
          <ul>
            {d.comments.map((c) => (
              <li><span class="who">{c.alias}（{storeName(lang, c.store)}）</span>{lang === 'ja' ? c.text_ja : c.text_zh}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <style>
  .category-breadcrumbs { font-size: .85rem; margin-bottom: 8px; }
  .category-breadcrumbs .badge { margin-left: 8px; }
    h1 { font-size: 1.35rem; margin: 0; }
    .title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; }
    .name-en { font-size: 0.95rem; color: var(--muted, #555); margin: 0.2rem 0 0; }
    h2 { font-size: 1.1rem; margin: 24px 0 4px; }
    .small { font-size: .85rem; }
    .obs { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
    .obs li { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
    .store { font-weight: 600; }
    .price { font-size: 1.3rem; font-weight: 700; margin: 4px 0; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
    .unit { font-size: .9rem; font-weight: 400; }
    .was { font-size: .85rem; font-weight: 400; text-decoration: line-through; }
    .off { font-size: .8rem; font-weight: 600; color: var(--ok); background: var(--ok-bg); padding: 1px 8px; border-radius: 999px; }
    .vs { font-size: .8rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--accent-bg); color: var(--accent); }
    .vs.cheaper { background: var(--ok-bg); color: var(--ok); }
    .vs.pricier { background: var(--warn-bg); color: var(--warn); }
    .online-link { margin: 6px 0 0; font-size: .88rem; }
    .report { margin: 6px 0 0; font-size: .8rem; text-align: right; }
    .report a { color: var(--muted); }
    dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; margin: 0; font-size: .88rem; }
    dt { color: var(--muted); }
    dd { margin: 0; }
    .evidence { margin-top: 8px; font-size: .88rem; }
    .evidence summary { cursor: pointer; color: var(--accent); }
    .talk-week { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin-top: 8px; }
    .talk-week h3 { font-size: .9rem; color: var(--muted); margin: 0 0 4px; font-weight: 600; }
    .talk-week ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
    .talk-week li { font-size: .95rem; }
    .who { font-weight: 600; margin-right: 6px; }
    .evidence img { display: block; max-width: 100%; height: auto; margin-top: 8px; border: 1px solid var(--line); border-radius: 8px; }
  </style>
</Base>
