---
import Base from '../layouts/Base.astro';
import FavButton from './FavButton.astro';
import { yen, COMMUNITY, CRAWLED, storeOrder, onlineDiff, discussionsFor, loadCategories, loadWeeklyDeals, priceRecords, loadRelatedProducts, physicalStoreCount, priceRange } from '../lib/data.js';
import { t, storeName, sourceName, statusName, noteText, localePath, productName, monthDay } from '../lib/i18n.js';
import { loadCoupons, activeCoupons, couponToday } from '../lib/coupons.js';
import { breadcrumb } from '../lib/seo.js';

const { p, lang } = Astro.props;
const s = t(lang);
const base = import.meta.env.BASE_URL;
// 價格錯誤回報：開 POYU 的 Google 表單，預填商品番号與店別（店別是下拉選單，值必須完全一致）。
const REPORT_FORM = 'https://docs.google.com/forms/d/e/1FAIpQLSfUbfKas65NDogV8cVmT2TewMTorUvHOdCtEz2pL_fY3UK7SA/viewform';
const FORM_STORES = ['熊本御船', '座間', '新三郷', '川崎', '浜松', '入間'];
const formStore = (st) => (st === '線上商店' ? 'オンライン' : FORM_STORES.find((x) => st.startsWith(x)) ?? 'その他');
const reportUrl = (o) => `${REPORT_FORM}?${new URLSearchParams({ usp: 'pp_url', 'entry.1082419553': o.item_no, 'entry.1812944459': formStore(o.store) })}`;
const name = productName(lang, p);
const categories = loadCategories();
const category = categories.find((c) => c.id === p.category);
const top = categories.find((c) => c.id === p.categoryTop);
const itemPath = `item/${p.id}/`;
const itemUrl = (path) => new URL(localePath(lang, path), Astro.site).href;
const crumbs = [[s.brand, itemUrl('')],
  ...(top && top.id !== category?.id ? [[top[lang], itemUrl(`category/${top.id}/`)]] : []),
  ...(category ? [[category[lang], itemUrl(`category/${category.id}/`)]] : []),
  [name, itemUrl(itemPath)]];
const talks = discussionsFor(p.item_no);
const records = priceRecords(p);
const showRecords = new Set(records.map((o) => o.period_to)).size >= 2;
const deals = loadWeeklyDeals();
const onSale = [...deals.storeSales, ...deals.onlineSales].some((card) => card.product.item_no === p.item_no);
const dropped = deals.priceDrops.some((card) => card.product.item_no === p.item_no);
// 本週官方電子報折價券（只在有效期內顯示；靜態頁過期後由瀏覽器隱藏）。
const coupon = activeCoupons(loadCoupons(), [p], couponToday()).find((c) => c.item_no === p.item_no);
const obs = [...p.current].sort((a, b) => storeOrder(a.store, b.store) || (b.period_to || '').localeCompare(a.period_to || ''));
const description = s.itemDescription(name, p.item_no, p.latest && { ...p.latest, store: storeName(lang, p.latest.store) }, p.stores.length, p.minPrice, p.maxPrice);
const related = loadRelatedProducts(p);
---
<Base lang={lang} path={itemPath} title={s.itemTitle(name)} description={description} image={p.image?.og_file} structuredData={[breadcrumb(crumbs)]}>
  <p><a href={localePath(lang)}>{s.back}</a></p>
  {(category || p.popular || onSale || dropped || coupon) && <nav class="category-breadcrumbs" aria-label={s.categoryBreadcrumb}>
    {top && <><a href={localePath(lang, `category/${top.id}/`)}>{top[lang]}</a> › </>}
    {category && <a href={localePath(lang, `category/${category.id}/`)}>{category[lang]}</a>}
    {p.popular && <a class="badge ok" href={localePath(lang, 'category/popular/')}>{s.popularBadge}</a>}
    {(onSale || dropped) && <a class="badge ok" href={localePath(lang, 'deals/')}>{onSale ? s.dealsSaleBadge : s.dealsDropBadge}</a>}
    {coupon && <a class="badge ok" href={`${localePath(lang, 'deals/')}#coupons`} data-coupon-until={coupon.week_to}>{s.couponsBadge}</a>}
  </nav>}
  <div class:list={['product-header', { 'has-image': p.image }]}>
  <div class="product-heading">
  <div class="title-row">
    <h1>{name}</h1>
    <FavButton id={p.id} lang={lang} />
  </div>
  {p.nameEn && <p class="name-en" lang="en">{p.nameEn}</p>}
  <p class="muted">{s.itemNoLabel(p.item_no)}</p>
  </div>
  {p.image && <figure class="product-illustration">
    <img src={`${base}${p.image.file}`} width="640" height="640" alt={lang === 'ja' ? p.image.alt_ja : p.image.alt_zh} decoding="async" />
    <figcaption class="muted small">{s.illustrationNote}</figcaption>
  </figure>}
  {p.onOfficialSite && (
    <p class="online-link head-link"><a href={`https://www.costco.co.jp/p/${p.item_no}`} rel="noopener" target="_blank">{s.openOnline} ↗</a></p>
  )}
  </div>

  {coupon && <section class="coupon-box" data-coupon-until={coupon.week_to}>
    <p class="coupon-head"><strong>{s.couponItemTitle}</strong> <span class="badge">{s.couponsBadge}</span></p>
    <p class="muted small">{coupon.name_ja}</p>
    <p class="coupon-price">
      {coupon.price_after != null && <span>{yen(coupon.price_after)}{coupon.price_unit === '100g' && s.per100g}</span>}
      {coupon.price_before != null && <span class="was muted">{s.wasPrice} {yen(coupon.price_before)}{coupon.price_unit === '100g' && s.per100g}</span>}
      {coupon.discount_yen != null ? <span class="off">{s.couponItemOff(coupon.discount_yen.toLocaleString('ja-JP'))}{coupon.price_unit === '100g' && s.per100g}</span> : <span class="off">{s.couponsSpecial}</span>}
      <span class="muted small">{s.couponItemUntil(monthDay(coupon.week_to))}</span>
    </p>
    <p class="muted small">{s.couponItemNote} <a href={`${localePath(lang, 'deals/')}#coupons`}>{s.couponItemMore}</a></p>
  </section>}
  {coupon && <script is:inline>
    (() => {
      const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(new Date());
      document.querySelectorAll('[data-coupon-until]').forEach((el) => { if (el.dataset.couponUntil < today) el.hidden = true; });
    })();
  </script>}

  <h2>{s.history}</h2>
  <p class="muted small">{s.historyNote}</p>
  {obs.some((o) => o.source_type === COMMUNITY) && <p class="muted small">{s.communityNote}</p>}
  <ul class="obs">
    {obs.map((o) => (
      <li>
        <div class="top">
          <span class="store">{storeName(lang, o.store)}</span>
          <span class={o.review_status === '已查核' ? 'badge ok' : 'badge pending'}>{statusName(lang, o.review_status)}</span>
        </div>
        <div class="price">
          {yen(o.price)}{o.price_unit === '100g' && <span class="unit">{s.per100g}</span>}
          {o.list_price && <span class="was muted">{s.wasPrice} {yen(o.list_price)}</span>}
          {o.discount && <span class="off">{s.off} {yen(o.discount)}</span>}
          {onlineDiff(o, p.observations) != null && (
            <span class={onlineDiff(o, p.observations) < 0 ? 'vs cheaper' : onlineDiff(o, p.observations) > 0 ? 'vs pricier' : 'vs'}>{s.vsOnline(onlineDiff(o, p.observations))}</span>
          )}
        </div>
        <dl>
          {o.spec && <><dt>{s.spec}</dt><dd>{o.spec}</dd></>}
          <dt>{s.source}</dt><dd>{sourceName(lang, o.source_type)}</dd>
          <dt>{s.observed}</dt><dd>{o.source_type === CRAWLED ? s.crawledOn(o.period_from, o.period_to) : s.period(o.period_from, o.period_to)}</dd>
          {o.promo_end && <><dt>{s.promoEnd}</dt><dd>{o.promo_end}</dd></>}
          {noteText(lang, o) && <><dt>{s.note}</dt><dd>{noteText(lang, o)}</dd></>}
        </dl>
        {o.source_type === CRAWLED && o.item_no && (
          <p class="online-link"><a href={`https://www.costco.co.jp/p/${o.item_no}`} rel="noopener" target="_blank">{s.openOnline} ↗</a></p>
        )}
        <p class="report"><a href={reportUrl(o)} rel="noopener" target="_blank">{s.reportError}</a></p>
        {o.evidence_image && (
          <details class="evidence">
            <summary>{s.showScreenshot}</summary>
            <img src={`${base}${o.evidence_image}`} alt={s.screenshotAlt(o.name || name)} loading="lazy" width="800" />
          </details>
        )}
      </li>
    ))}
  </ul>

  {showRecords && <details class="price-records">
    <summary>{s.pastRecords(records.length)}</summary>
    <p class="muted small">{s.pastRecordsNote}</p>
    {records.some((o) => o.source_type === COMMUNITY) && <p class="muted small">{s.communityNote}</p>}
    <div class="records-scroll" tabindex="0" role="region" aria-label={s.pastRecords(records.length)}>
      <table>
        <thead><tr><th scope="col">{s.observed}</th><th scope="col">{s.recordsStore}</th><th scope="col">{s.recordsPrice}</th><th scope="col">{s.recordsStatus}</th></tr></thead>
        <tbody>{records.map((o) => <tr data-record={o.record_id}>
          <td>{o.source_type === CRAWLED ? s.crawledOn(o.period_from, o.period_to) : s.period(o.period_from, o.period_to)}</td>
          <td>{storeName(lang, o.store)}<small class="muted">{sourceName(lang, o.source_type)}</small></td>
          <td>{yen(o.price)}{o.price_unit === '100g' && s.per100g}
            {o.list_price != null && <small class="muted">{s.wasPrice} {yen(o.list_price)}{o.price_unit === '100g' && s.per100g}</small>}
          </td>
          <td><span class={o.review_status === '已查核' ? 'badge ok' : 'badge pending'}>{statusName(lang, o.review_status)}</span>
            {noteText(lang, o) && <small class="muted">{noteText(lang, o)}</small>}
          </td>
        </tr>)}</tbody>
      </table>
    </div>
  </details>}

  {related.length > 0 && <section class="related-products">
    <h2>{s.relatedTitle}</h2>
    <ul class="list">
      {related.map((q) => <li>
        <a href={localePath(lang, `item/${q.id}/`)}>
          <span class="name">{productName(lang, q)}</span>
          <span class="row">
            <span class="price">{priceRange(q.minPrice, q.maxPrice) ?? priceRange(q.min100g, q.max100g, s.per100g)}</span>
            <span class="muted small">{s.relatedStores(physicalStoreCount(q))}</span>
          </span>
        </a>
      </li>)}
    </ul>
    {category && <p class="small"><a href={localePath(lang, `category/${p.category}/`)}>{s.relatedCategory(category[lang])}</a></p>}
  </section>}

  {talks.length > 0 && (
    <section class="talks">
      <h2>{s.discussions}</h2>
      <p class="muted small">{s.discussionsNote}</p>
      {talks.map((d) => (
        <div class="talk-week">
          <h3>{s.heatPeriod(d.from, d.to)}</h3>
          <ul>
            {d.comments.map((c) => (
              <li><span class="who">{c.alias}（{storeName(lang, c.store)}）</span>{lang === 'ja' ? c.text_ja : c.text_zh}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}

  <style>
    /* ProductList 的卡片樣式；僅限相關商品，不改原有價格清單。 */
    .related-products .list { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
    .related-products .list li { min-width: 0; }
    .related-products .list a { display: grid; gap: 2px; padding: 12px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; text-decoration: none; color: var(--text); min-width: 0; overflow-wrap: anywhere; }
    .related-products .name { font-weight: 600; }
    .related-products .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; align-items: baseline; }
    .related-products .price { font-weight: 700; font-size: 1.05rem; font-variant-numeric: tabular-nums; margin: 0; }
    .price-records { min-width: 0; margin-top: 24px; }
    .price-records summary { cursor: pointer; font-weight: 600; color: var(--accent); }
    .records-scroll { max-width: 100%; overflow-x: auto; }
    .price-records table { width: 100%; border-collapse: collapse; background: var(--card); font-size: .85rem; }
    .price-records th, .price-records td { text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); padding: 6px 4px; }
    .price-records small { display: block; }
    .price-records td:nth-child(3) { white-space: nowrap; }
    .product-heading { min-width: 0; }
    .product-illustration { margin: 12px 0 0; text-align: center; }
    .product-illustration img { display: block; width: 160px; max-width: 100%; height: auto; margin: 0 auto; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
    .product-illustration figcaption { margin-top: 4px; }
    @media (min-width: 720px) {
      .product-header.has-image { display: grid; grid-template-columns: minmax(0, 1fr) 200px; grid-template-rows: min-content 1fr; column-gap: 20px; align-items: start; }
      .has-image .product-heading { grid-column: 1; grid-row: 1; }
      .product-illustration { grid-column: 2; grid-row: 1 / span 2; margin: 0; }
      .product-illustration img { width: 200px; }
      .has-image .head-link { grid-column: 1; }
    }
  .category-breadcrumbs { font-size: .85rem; margin-bottom: 8px; }
  .category-breadcrumbs .badge { margin-left: 8px; }
    .coupon-box { margin-top: 16px; padding: 12px 14px; border: 1px solid var(--ok); border-radius: 10px; background: var(--ok-bg); }
    .coupon-box p { margin: 0; }
    .coupon-box .coupon-price { font-size: 1.2rem; font-weight: 700; margin: 4px 0; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
    .coupon-box .badge { margin-left: 6px; }
    h1 { font-size: 1.35rem; margin: 0; }
    .title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px 12px; flex-wrap: wrap; }
    .name-en { font-size: 0.95rem; color: var(--muted, #555); margin: 0.2rem 0 0; }
    h2 { font-size: 1.1rem; margin: 24px 0 4px; }
    .small { font-size: .85rem; }
    .obs { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
    .obs li { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
    .store { font-weight: 600; }
    .price { font-size: 1.3rem; font-weight: 700; margin: 4px 0; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
    .unit { font-size: .9rem; font-weight: 400; }
    .was { font-size: .85rem; font-weight: 400; text-decoration: line-through; }
    .off { font-size: .8rem; font-weight: 600; color: var(--ok); background: var(--ok-bg); padding: 1px 8px; border-radius: 999px; }
    .vs { font-size: .8rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--accent-bg); color: var(--accent); }
    .vs.cheaper { background: var(--ok-bg); color: var(--ok); }
    .vs.pricier { background: var(--warn-bg); color: var(--warn); }
    .online-link { margin: 6px 0 0; font-size: .88rem; }
    .report { margin: 6px 0 0; font-size: .8rem; text-align: right; }
    .report a { color: var(--muted); }
    dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; margin: 0; font-size: .88rem; }
    dt { color: var(--muted); }
    dd { margin: 0; }
    .evidence { margin-top: 8px; font-size: .88rem; }
    .evidence summary { cursor: pointer; color: var(--accent); }
    .talk-week { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin-top: 8px; }
    .talk-week h3 { font-size: .9rem; color: var(--muted); margin: 0 0 4px; font-weight: 600; }
    .talk-week ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
    .talk-week li { font-size: .95rem; }
    .who { font-weight: 600; margin-right: 6px; }
    .evidence img { display: block; max-width: 100%; height: auto; margin-top: 8px; border: 1px solid var(--line); border-radius: 8px; }
  </style>
</Base>
