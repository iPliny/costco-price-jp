---
import Base from '../layouts/Base.astro';
import { loadPosts } from '../lib/blog.js';
import { t, localePath } from '../lib/i18n.js';

// 週報只有中文版，日文版沒有對應頁。
const lang = 'zh';
const s = t(lang);
const posts = loadPosts();
---
<Base lang={lang} path="blog/" only="zh" title={s.blogTitle} description={s.blogDescription}>
  <h1>{s.blogHeading}</h1>
  <p class="muted small">{s.blogLead}</p>
  <p class="small"><a href={localePath(lang, 'deals/')}>{s.dealsListLink}</a></p>
  {posts.length === 0 ? (
    <p class="muted">{s.blogEmpty}</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`./${p.slug}/`}>
            <span class="date">{p.date}</span>
            <span class="title">{p.title}</span>
            <span class="desc">{p.description}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <style>
    h1 { font-size: 1.45rem; margin: 4px 0 8px; }
    .small { font-size: .85rem; }
    .posts { list-style: none; padding: 0; margin: 16px 0; display: grid; gap: 12px; }
    .posts a { display: grid; gap: 4px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; text-decoration: none; color: var(--text); }
    .posts a:hover, .posts a:focus-visible { border-color: var(--accent); }
    .date { font-size: .8rem; color: var(--muted); }
    .title { font-weight: 700; color: var(--accent); line-height: 1.45; }
    .desc { font-size: .9rem; color: var(--muted); }
  </style>
</Base>
