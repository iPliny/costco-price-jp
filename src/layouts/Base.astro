---
import { PREVIEW } from '../lib/data.js';
import { LANGS, t, localePath } from '../lib/i18n.js';
import { GA_ID, GSC_VERIFICATION } from '../lib/site.js';
// path：語系內的相對路徑（首頁為 ''，商品頁為 'item/<id>/'），用來產生切換連結與 hreflang。
const { lang = 'ja', path = '', title, description = t(lang).siteDescription } = Astro.props;
const s = t(lang);
const other = lang === 'ja' ? 'zh' : 'ja';
const abs = (l) => (Astro.site ? new URL(localePath(l, path), Astro.site).href : localePath(l, path));
---
<!doctype html>
<html lang={LANGS[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="ja" href={abs('ja')} />
    <link rel="alternate" hreflang="zh-Hant" href={abs('zh')} />
    <link rel="alternate" hreflang="x-default" href={abs('ja')} />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    {GA_ID && !PREVIEW && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
    {PREVIEW && <meta name="robots" content="noindex" />}
    <style is:global>
      :root {
        --bg: #f6f7f9; --card: #ffffff; --text: #1d2330; --muted: #5d6677;
        --line: #e2e5ea; --accent: #0b5cad; --accent-bg: #e8f1fb;
        --warn: #8a5a00; --warn-bg: #fff4dc; --ok: #1d6b35; --ok-bg: #e5f5ea;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --bg: #14171c; --card: #1d2128; --text: #e7eaf0; --muted: #9aa3b2;
          --line: #2d333d; --accent: #7fb5ee; --accent-bg: #1c2b3d;
          --warn: #f3c46b; --warn-bg: #3a2e14; --ok: #7fd49a; --ok-bg: #173022;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #14171c; --card: #1d2128; --text: #e7eaf0; --muted: #9aa3b2;
        --line: #2d333d; --accent: #7fb5ee; --accent-bg: #1c2b3d;
        --warn: #f3c46b; --warn-bg: #3a2e14; --ok: #7fd49a; --ok-bg: #173022;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text);
        font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans TC", "Noto Sans JP", sans-serif;
        line-height: 1.6; }
      a { color: var(--accent); }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 16px; }
      header.site { background: var(--card); border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; align-items: center; gap: 12px; min-height: 56px; }
      header.site .wrap { justify-content: space-between; }
      header.site a.brand { font-weight: 700; text-decoration: none; color: var(--text); font-size: 1.1rem; }
      a.lang-switch { font-size: .85rem; text-decoration: none; border: 1px solid var(--line); border-radius: 999px;
        padding: 4px 12px; color: var(--text); white-space: nowrap; }
      .site-nav { display: flex; align-items: center; gap: 12px; }
      a.nav-link { font-size: .9rem; font-weight: 600; text-decoration: none; }
      a.lang-switch:hover, a.lang-switch:focus-visible { border-color: var(--accent); color: var(--accent); }
      .preview-bar { background: var(--warn-bg); color: var(--warn); font-size: .85rem; padding: 6px 0; }
      main { padding: 20px 0 40px; }
      footer { color: var(--muted); font-size: .8rem; padding: 24px 0 40px; border-top: 1px solid var(--line); }
      footer p { margin: 0 0 8px; }
      .badge { display: inline-block; font-size: .75rem; padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
      .badge.ok { background: var(--ok-bg); color: var(--ok); }
      .badge.pending { background: var(--warn-bg); color: var(--warn); }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    {PREVIEW && (
      <div class="preview-bar"><div class="wrap">{s.previewBar}</div></div>
    )}
    <header class="site"><div class="wrap">
      <a class="brand" href={localePath(lang)}>{s.brand}</a>
      <nav class="site-nav">
        <a class="nav-link" href={localePath(lang, 'ranking/')}>{s.navRanking}</a>
        <a class="lang-switch" href={localePath(other, path)} hreflang={LANGS[other].htmlLang} lang={LANGS[other].htmlLang}>{LANGS[other].label}</a>
      </nav>
    </div></header>
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">
      <p>{s.footer}</p>
      {GA_ID && <p>{s.analyticsNotice}</p>}
    </div></footer>
  </body>
</html>
