---
import { PREVIEW } from '../lib/data.js';
const { title, description = '日本好市多（Costco Japan）各倉庫店價格紀錄查詢。' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {PREVIEW && <meta name="robots" content="noindex" />}
    <style is:global>
      :root {
        --bg: #f6f7f9; --card: #ffffff; --text: #1d2330; --muted: #5d6677;
        --line: #e2e5ea; --accent: #0b5cad; --accent-bg: #e8f1fb;
        --warn: #8a5a00; --warn-bg: #fff4dc; --ok: #1d6b35; --ok-bg: #e5f5ea;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --bg: #14171c; --card: #1d2128; --text: #e7eaf0; --muted: #9aa3b2;
          --line: #2d333d; --accent: #7fb5ee; --accent-bg: #1c2b3d;
          --warn: #f3c46b; --warn-bg: #3a2e14; --ok: #7fd49a; --ok-bg: #173022;
        }
      }
      :root[data-theme="dark"] {
        color-scheme: dark;
        --bg: #14171c; --card: #1d2128; --text: #e7eaf0; --muted: #9aa3b2;
        --line: #2d333d; --accent: #7fb5ee; --accent-bg: #1c2b3d;
        --warn: #f3c46b; --warn-bg: #3a2e14; --ok: #7fd49a; --ok-bg: #173022;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--text);
        font-family: system-ui, -apple-system, "Hiragino Sans", "Noto Sans TC", "Noto Sans JP", sans-serif;
        line-height: 1.6; }
      a { color: var(--accent); }
      .wrap { max-width: 880px; margin: 0 auto; padding: 0 16px; }
      header.site { background: var(--card); border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; align-items: center; gap: 12px; min-height: 56px; }
      header.site a.brand { font-weight: 700; text-decoration: none; color: var(--text); font-size: 1.1rem; }
      .preview-bar { background: var(--warn-bg); color: var(--warn); font-size: .85rem; padding: 6px 0; }
      main { padding: 20px 0 40px; }
      footer { color: var(--muted); font-size: .8rem; padding: 24px 0 40px; border-top: 1px solid var(--line); }
      .badge { display: inline-block; font-size: .75rem; padding: 1px 8px; border-radius: 999px; white-space: nowrap; }
      .badge.ok { background: var(--ok-bg); color: var(--ok); }
      .badge.pending { background: var(--warn-bg); color: var(--warn); }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    {PREVIEW && (
      <div class="preview-bar"><div class="wrap">內部預覽：含尚未查核的資料，正式站只會顯示已查核紀錄。</div></div>
    )}
    <header class="site"><div class="wrap"><a class="brand" href={base}>Costco 價格紀錄</a></div></header>
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">
      價格來自門市價牌、官網等來源的觀測紀錄，標示為「某期間曾觀測到的價格」，不代表今日售價。實際價格以店內標示為準。本站與 Costco 無關。
    </div></footer>
  </body>
</html>
