---
import Base from '../../layouts/Base.astro';
import { loadProducts, yen, period } from '../../lib/data.js';

export function getStaticPaths() {
  return loadProducts().map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const base = import.meta.env.BASE_URL;
const obs = [...p.observations].sort((a, b) => a.store.localeCompare(b.store, 'ja') || (b.period_to || '').localeCompare(a.period_to || ''));
---
<Base title={`${p.name}｜Costco 價格紀錄`} description={`${p.name}（Costco 商品號 ${p.item_no || '待補'}）在日本各 Costco 倉庫店的價格觀測紀錄。`}>
  <p><a href={base}>← 回到商品列表</a></p>
  <h1>{p.name}</h1>
  <p class="muted">{p.item_no ? `Costco 商品號 ${p.item_no}` : 'Costco 商品號待補'}</p>

  <h2>價格紀錄</h2>
  <p class="muted small">紀錄太少時不畫價格曲線；每筆標示的是「該期間曾觀測到」的價格，不代表整段期間每天都是這個價。</p>
  <ul class="obs">
    {obs.map((o) => (
      <li>
        <div class="top">
          <span class="store">{o.store}</span>
          <span class={o.review_status === '已查核' ? 'badge ok' : 'badge pending'}>{o.review_status}</span>
        </div>
        <div class="price">
          {yen(o.price)}{o.price_unit === '100g' && <span class="unit">／100g</span>}
          {o.list_price && <span class="was muted">原價 {yen(o.list_price)}</span>}
          {o.discount && <span class="off">折 {yen(o.discount)}</span>}
        </div>
        <dl>
          {o.spec && <><dt>規格</dt><dd>{o.spec}</dd></>}
          <dt>來源</dt><dd>{o.source_type}</dd>
          <dt>觀測</dt><dd>{period(o)}</dd>
          {o.promo_end && <><dt>優惠至</dt><dd>{o.promo_end}</dd></>}
          {o.note && <><dt>備註</dt><dd>{o.note}</dd></>}
        </dl>
      </li>
    ))}
  </ul>

  <style>
    h1 { font-size: 1.35rem; margin: 0; }
    h2 { font-size: 1.1rem; margin: 24px 0 4px; }
    .small { font-size: .85rem; }
    .obs { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
    .obs li { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .top { display: flex; justify-content: space-between; gap: 8px; align-items: center; }
    .store { font-weight: 600; }
    .price { font-size: 1.3rem; font-weight: 700; margin: 4px 0; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
    .unit { font-size: .9rem; font-weight: 400; }
    .was { font-size: .85rem; font-weight: 400; text-decoration: line-through; }
    .off { font-size: .8rem; font-weight: 600; color: var(--ok); background: var(--ok-bg); padding: 1px 8px; border-radius: 999px; }
    dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; margin: 0; font-size: .88rem; }
    dt { color: var(--muted); }
    dd { margin: 0; }
  </style>
</Base>
